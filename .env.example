# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,192.168.0.50,spotonappliancecleaning.co.uk,www.spotonappliancecleaning.co.uk,spoton.vehiclecare.online
DJANGO_CSRF_TRUSTED_ORIGINS=https://spotonappliancecleaning.co.uk,https://www.spotonappliancecleaning.co.uk,https://spoton.vehiclecare.online,http://192.168.0.50:8999

# PostgreSQL — connect to Postgres already running on the Ubuntu host
DB_ENGINE=postgresql
DB_NAME=spotoncleaning
DB_USER=spoton
DB_PASSWORD=change-me
DB_HOST=host.docker.internal
DB_PORT=5432

# If using bundled Docker Postgres instead (docker compose --profile bundled-db up -d):
# DB_HOST=db
# DB_PUBLISH_PORT=5433

# SQLite fallback — set DB_ENGINE=sqlite to use instead
# SQLITE_PATH=/app/data/db.sqlite3

# App
WEB_PORT=8999
APP_PORT=8999
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=120
SCHEDULE_DEBUG=False

# UK address lookup — sign up at https://ideal-postcodes.co.uk (free trial credits)
# In local DEBUG mode, ak_test is used automatically if this is unset
IDEAL_POSTCODES_API_KEY=
ADDRESS_LOOKUP_ENABLED=True

# Protected system administrator account(s) — comma-separated emails
SYSADMIN_EMAILS=brad.crampton2001@gmail.com

# SEO — use www; bare domain may not proxy to the Docker app on Cloudflare
SITE_URL=https://www.spotonappliancecleaning.co.uk
CANONICAL_HOST=www.spotonappliancecleaning.co.uk
SITE_LOCAL_AREA=West Yorkshire
# Restrict online bookings to this area (validated via postcode)
SERVICE_AREA_NAME=West Yorkshire
SERVICE_AREA_ENFORCED=True
# SITE_DESCRIPTION=
# SITE_KEYWORDS=

# Email — Zoho Mail (EU/UK accounts use smtp.zoho.eu)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.zoho.eu
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
# Full mailbox address — must match DEFAULT_FROM_EMAIL domain/user
EMAIL_HOST_USER=info@spotonappliancecleaning.co.uk
# Use a Zoho *application-specific password*, not your login password (required if 2FA is on)
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Spot On Appliance Cleaning <info@spotonappliancecleaning.co.uk>

# Day-before booking reminders — schedule daily on the host, e.g. 18:00:
# docker compose exec web python manage.py send_booking_reminders
BOOKING_REMINDERS_ENABLED=True

# SMS reminders (optional — Twilio). Email reminders work without these.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=+447XXXXXXXXX

# SiteMatrix — site live / subscription gate (fail open if SiteMatrix is down)
# SITEMATRIX_STATUS_URL=https://your-sitematrix-domain.com/api/v1/status/
# SITEMATRIX_API_KEY=
# SITEMATRIX_PORTAL_URL=https://your-sitematrix-domain.com/dashboard/
# SITEMATRIX_SUPPORT_URL=https://your-sitematrix-domain.com/contact/
# SITEMATRIX_CACHE_SECONDS=300
# SITEMATRIX_DEBUG=True
