# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,192.168.0.50,spotonappliancecleaning.co.uk,www.spotonappliancecleaning.co.uk,spoton.vehiclecare.online
DJANGO_CSRF_TRUSTED_ORIGINS=https://spotonappliancecleaning.co.uk,https://www.spotonappliancecleaning.co.uk,https://spoton.vehiclecare.online,http://192.168.0.50:8999

# PostgreSQL — connect to Postgres already running on the Ubuntu host
DB_ENGINE=postgresql
DB_NAME=spotoncleaning
DB_USER=spoton
DB_PASSWORD=change-me
DB_HOST=host.docker.internal
DB_PORT=5432

# If using bundled Docker Postgres instead (docker compose --profile bundled-db up -d):
# DB_HOST=db
# DB_PUBLISH_PORT=5433

# SQLite fallback — set DB_ENGINE=sqlite to use instead
# SQLITE_PATH=/app/data/db.sqlite3

# App
WEB_PORT=8999
APP_PORT=8999
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=120
SCHEDULE_DEBUG=False

# Protected system administrator account(s) — comma-separated emails
SYSADMIN_EMAILS=brad.crampton2001@gmail.com

# Email (optional)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=
